# Required
MONGODB_URI=mongodb://localhost:27017/unipass
NEXT_PUBLIC_BASE_URL=http://localhost:43123

# First admin user, used by `npm run seed`
ADMIN_EMAIL=admin@unipass.local
ADMIN_PASSWORD=YourSecurePassword123!

# Email (choose one, or leave empty to log messages in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=UniPass <noreply@unipass.example.com>
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Images. Leave these unset to store uploads in public/uploads (local only).
# Those files are not persistent on Vercel-like hosts. Set all three before go-live
# and the app switches to Cloudinary without a code change.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
